RINGLENS_FALKORDB_HOST=127.0.0.1
RINGLENS_FALKORDB_PORT=6379
# Generate a local password with: openssl rand -hex 32
# Paste it here before starting Docker Compose. Never commit .env.
RINGLENS_FALKORDB_PASSWORD=
RINGLENS_GRAPH_NAME=ringlens_demo
RINGLENS_LOG_LEVEL=INFO

# Agent only; ordinary investigation/review commands need no provider credentials.
RINGLENS_OPENAI_API_KEY=
# Set a Responses API model available to your project. No model is assumed.
RINGLENS_AGENT_MODEL=
RINGLENS_AGENT_TIMEOUT_SECONDS=30
RINGLENS_AGENT_MAX_TURNS=8
RINGLENS_AGENT_MAX_TOOL_CALLS=16
